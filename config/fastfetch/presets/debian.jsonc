{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/logos/debian_trans.png",
        "color": 
        {
            "1": "magenta"
        }
  },
  "display": {
      "separator": " ",
      "color":
      {
            "keys": "magenta",
            "title": "magenta"
      }
  },
  "modules": [
    "title",
    "separator",
    
    {
        "type": "os",
        "key": " OS",
        "format": "{name} {version} ({codename}) {arch}"
    },
    {
        "type": "host",
        "key": " Host"
    },
    {
        "type": "kernel",
        "key": " Kernel"
    },
    {
        "type": "packages",
        "key": "󰆧 Packages"
    },
    {
        "type": "terminal",
        "key": " Terminal"
    },
    {
        "type": "shell",
        "key": " Shell"
    },
    {
        "type": "localip",
        "key": " Local IP"
    },
    
    "break",
    
    {
        "type": "uptime",
        "key": "󰥔 Uptime",
        "keyColor": "blue"
    },
    {
        "type": "command",
        "key": " OS Birthday",
        "keyColor": "blue",
        //"folders": "/",
        //"format": "{create-time:10} ({days} days)",
        "text": "date -d @$(stat -c %W /) '+%d %B %Y'"
    },

    "break",
    
    {
        "type": "battery",
        "key": " Battery",
        "keyColor": "green"
    },
    {
        "type": "memory",
        "key": " RAM",
        "keyColor": "green"
    },
    {
        "type": "swap",
        "key": " Swap",
        "keyColor": "green"
    },
    {
        "type": "disk",
        "key": "󰋊 Disk ({mountpoint})",
        "keyColor": "green"
    },
    {
        "type": "cpu",
        "key": " CPU",
        "keyColor": "green"
    },
    {
        "type": "gpu",
        "key": " GPU",
        "keyColor": "green"
    },
    {
        "type": "display",
        "key": "󰍹 Display ({name})",
        "keyColor": "green"
    },

    "break",
    
    {
        "type": "de",
        "key": " DE",
        "keyColor": "red"
    },
    {
        "type": "wm",
        "key": "󱂬 WM",
        "keyColor": "red"
    },
    {
        "type": "wmtheme",
        "key": " WM Theme",
        "keyColor": "red"
    },
    {
        "type": "theme",
        "key": " Theme",
        "keyColor": "red"
    },
    {
        "type": "icons",
        "key": " Icons",
        "keyColor": "red"
    },
    {
        "type": "cursor",
        "key": " Cursor",
        "keyColor": "red"
    },
    {
        "type": "terminalfont",
        "key": " Terminal Font",
        "keyColor": "red"
    },
    
    "break",
    
    "colors"
  ]
}

ble-face -s argument_option fg=cyan
ble-face -s command_alias fg=cyan,bold
ble-face -s auto_complete fg=white,bg=purple
ble-face -s command_builtin fg=red,bold
ble-face -s command_builtin_dot fg=red,bold
ble-face -s command_directory fg=magenta,bold
ble-face -s command_file fg=lime,bold
ble-face -s command_function fg=blue,bold
ble-face -s command_jobs fg=red,bold
ble-face -s command_keyword fg=yellow,bold
ble-face -s disabled fg=8
ble-face -s filename_block fg=3,bg=black,bold
ble-face -s filename_character fg=3,bg=black,bold
ble-face -s filename_directory fg=magenta,bold
ble-face -s filename_directory_sticky fg=black,bg=green
ble-face -s filename_executable fg=lime,bold
ble-face -s filename_link fg=blue,bold
ble-face -s filename_orphan fg=1,bg=black,bold,italic
ble-face -s filename_setgid fg=7,bg=1
ble-face -s filename_setuid fg=black,bg=3
ble-face -s filename_socket fg=purple,bold
ble-face -s filename_url fg=blue,italic,underline
ble-face -s filename_warning fg=red,underline
ble-face -s syntax_brace fg=teal,bold
ble-face -s syntax_comment fg=purple,italic
ble-face -s syntax_error bg=red,bold
ble-face -s syntax_quotation fg=7,bold
ble-face -s syntax_quoted fg=7


